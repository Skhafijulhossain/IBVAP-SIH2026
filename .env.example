# IBVAP Defense Platform Environment Configuration
# Backend API & WebSocket Gateway (Render, local, or custom host)
VITE_API_BASE_URL=https://ibvap-backend-22xy.onrender.com
VITE_WS_BASE_URL=wss://ibvap-backend-22xy.onrender.com/ws

# Frontend Supabase Authentication & Realtime Client
# Replace with your project credentials from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend FastAPI Supabase Authentication Verification (Render Environment)
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
